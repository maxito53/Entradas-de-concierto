{
    "name": "max/microservicios",
    "description": "Microservicios para la cración de entidades relativas a las entradas de concierto",
    "type": "project",
    "require": {
        "doctrine/orm": "3.3",
        "doctrine/dbal": "^3.2",
        "symfony/cache": "^5.4"
    },
    "autoload": {
        "psr-4" : {
			"Entradas\\Entity\\" : "src/Entradas",
			"" : [
				"src/Controller",
				"src/Entradas",
				"src/Model",
                "src/Service"
			]
		}
    },
    "authors": [
        {
            "name": "Max Tura Aguilera",
            "email": "mtaguil5@gmail.com"
        }
    ]
}
